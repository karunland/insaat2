---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ROUTES, useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const tm = t.home.team;

// src/assets/ekip/ klasörüne eklenen her fotoğraf otomatik olarak slider'a dahil olur
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/ekip/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section team-section" aria-label={tm.aria}>
  <div class="team-grid">
    {photos.length > 0 && (
      <div class="team-slider reveal" data-team-slider>
        <div class="team-frame">
          <div class="team-viewport" data-team-viewport>
            <div class="team-track" data-team-track>
              {photos.map((src, i) => (
                <div class="team-slide">
                  <Image
                    src={src}
                    alt={`${tm.caption} ${i + 1}`}
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 900px) 100vw, 55vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="team-bar">
          <span class="team-counter">
            <b data-team-current>01</b> / {pad(photos.length)}
            <span class="team-sep" aria-hidden="true">·</span>
            {tm.caption}
          </span>

          {photos.length > 1 && (
            <div class="team-controls">
              <button type="button" class="team-nav-btn" data-team-prev aria-label={tm.prevAria}>
                <span aria-hidden="true">←</span>
              </button>
              <div class="team-dots" data-team-dots>
                {photos.map((_, i) => (
                  <button
                    type="button"
                    class:list={['team-dot', { 'is-active': i === 0 }]}
                    data-team-dot={i}
                    aria-label={`${tm.caption} ${i + 1}`}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  ></button>
                ))}
              </div>
              <button type="button" class="team-nav-btn" data-team-next aria-label={tm.nextAria}>
                <span aria-hidden="true">→</span>
              </button>
            </div>
          )}
        </div>
      </div>
    )}

    <div class="team-copy reveal">
      <h2 set:html={tm.h} />
      <p>{tm.p1}</p>
      <p>{tm.p2}</p>
      <a class="link-arrow" href={ROUTES.about[lang]}>{tm.link} →</a>
    </div>
  </div>
</section>

<script>
  (function () {
    const sliders = Array.from(document.querySelectorAll<HTMLElement>('[data-team-slider]'));
    if (!sliders.length) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    sliders.forEach((root) => {
      const viewport = root.querySelector<HTMLElement>('[data-team-viewport]');
      const track = root.querySelector<HTMLElement>('[data-team-track]');
      const slides = Array.from(root.querySelectorAll<HTMLElement>('.team-slide'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-team-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-team-next]');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-team-dot]'));
      const currentEl = root.querySelector<HTMLElement>('[data-team-current]');

      if (!viewport || !track || slides.length < 2) return;

      let idx = 0;
      let timer = 0;
      let hovered = false;
      let startX = 0;
      let startY = 0;

      function go(next: number) {
        idx = (next + slides.length) % slides.length;
        track!.style.transform = `translate3d(-${idx * 100}%, 0, 0)`;
        if (currentEl) currentEl.textContent = String(idx + 1).padStart(2, '0');
        dots.forEach((d, i) => {
          const on = i === idx;
          d.classList.toggle('is-active', on);
          d.setAttribute('aria-pressed', String(on));
        });
      }

      function stop() {
        if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      }

      function start() {
        stop();
        if (reduceMotion || hovered) return;
        timer = window.setInterval(() => go(idx + 1), 3600);
      }

      prevBtn?.addEventListener('click', () => { go(idx - 1); start(); });
      nextBtn?.addEventListener('click', () => { go(idx + 1); start(); });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => { go(i); start(); });
      });

      const controls = root.querySelector('.team-controls');
      controls?.addEventListener('mouseenter', () => { hovered = true; stop(); });
      controls?.addEventListener('mouseleave', () => { hovered = false; start(); });

      viewport.addEventListener('touchstart', (e) => {
        if (!e.touches.length) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      }, { passive: true });

      viewport.addEventListener('touchend', (e) => {
        if (!e.changedTouches.length) return;
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          go(dx < 0 ? idx + 1 : idx - 1);
          start();
        }
      }, { passive: true });

      start();
    });
  })();
</script>

<style>
  .team-section {
    padding-top: clamp(56px, 6.5vw, 88px);
    padding-bottom: clamp(40px, 5vw, 68px);
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(24px, 3.5vw, 48px);
    align-items: center;
  }

  .team-slider {
    min-width: 0;
    padding: 6px 6px 0;
  }

  .team-frame {
    position: relative;
  }
  .team-frame::before,
  .team-frame::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    border-color: var(--line-strong);
    border-style: solid;
    border-width: 0;
    transition: border-color 0.25s var(--ease);
  }
  .team-frame::before { top: -6px; left: -6px; border-top-width: 1.5px; border-left-width: 1.5px; }
  .team-frame::after { right: -6px; bottom: -6px; border-right-width: 1.5px; border-bottom-width: 1.5px; }
  .team-slider:hover .team-frame::before,
  .team-slider:hover .team-frame::after {
    border-color: var(--ink);
  }

  .team-viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
  }

  .team-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .team-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }
  .team-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    margin-top: 12px;
  }

  .team-counter {
    font: 500 11px/1 var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .team-counter b {
    color: var(--ink);
    font-weight: 600;
  }
  .team-sep {
    margin: 0 6px;
    opacity: 0.5;
  }

  .team-controls {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .team-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: 600 12px/1 var(--f-mono);
    cursor: pointer;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .team-nav-btn:hover {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .team-dots {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
  }
  .team-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.2s var(--ease), background 0.2s var(--ease);
  }
  .team-dot:hover { opacity: 0.85; }
  .team-dot.is-active {
    opacity: 1;
    background: var(--ink);
  }

  .team-copy h2 {
    font-size: clamp(32px, 3.8vw, 52px);
    font-stretch: 86%;
    margin-bottom: 20px;
  }
  .team-copy p {
    margin: 0 0 16px;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.65;
  }
  .team-copy .link-arrow {
    display: inline-block;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-track { transition: none; }
  }
</style>
