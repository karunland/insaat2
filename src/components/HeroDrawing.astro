---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const d = t.home.drawing;
---
<figure class="hero-drawing" aria-label={t.home.drawingAria}>
  <svg viewBox="0 0 560 520" class="frame-svg" aria-hidden="true">
    <defs>
      <pattern id="soil" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="14" class="hatch-line" />
      </pattern>
      <pattern id="concrete" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="4" cy="5" r="1" class="dot" /><circle cx="15" cy="12" r="1.4" class="dot" /><path d="M8 17 l3 -2 l1 3z" class="dot" />
      </pattern>
      <linearGradient id="concrete-front" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#d9e7f4" />
        <stop offset=".52" stop-color="#8ca8c2" />
        <stop offset="1" stop-color="#526d89" />
      </linearGradient>
      <linearGradient id="concrete-side" x1="0" x2="1">
        <stop offset="0" stop-color="#66819c" />
        <stop offset="1" stop-color="#304a65" />
      </linearGradient>
      <linearGradient id="floor-fill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#71cfff" stop-opacity=".18" />
        <stop offset="1" stop-color="#71cfff" stop-opacity=".025" />
      </linearGradient>
      <filter id="frame-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.4" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <g class="blueprint">
    <g>
      {[100, 220, 340, 460].map((x, i) => (
        <line x1={x} y1="44" x2={x} y2="500" class="axis draw" pathLength="1" style={`--d:${0.1 + i * 0.1}s`} />
      ))}
      <g class="fade" style="--d:.5s">
        {['A', 'B', 'C', 'D'].map((l, i) => (
          <>
            <circle cx={100 + i * 120} cy="30" r="14" class="bubble" />
            <text x={100 + i * 120} y="35" class="bubble-t">{l}</text>
          </>
        ))}
      </g>
    </g>
    <g class="fade" style="--d:2.9s">
      <line x1="100" y1="78" x2="460" y2="78" class="dim" />
      <path d="M96 82 l8 -8 M216 82 l8 -8 M336 82 l8 -8 M456 82 l8 -8" class="dim" />
      <text x="160" y="72" class="dim-t">6.00</text><text x="280" y="72" class="dim-t">6.00</text><text x="400" y="72" class="dim-t">6.00</text>
    </g>
    <rect x="20" y="430" width="520" height="70" fill="url(#soil)" class="fade" style="--d:.6s" />
    <line x1="20" y1="430" x2="540" y2="430" class="ground draw" pathLength="1" style="--d:.5s" />
    <rect x="78" y="408" width="404" height="22" class="found draw" pathLength="1" style="--d:.8s" />
    <rect x="78" y="408" width="404" height="22" fill="url(#concrete)" class="fade" style="--d:1.2s" />
    {[100, 220, 340, 460].map((x, i) => (
      <line x1={x} y1="408" x2={x} y2="110" class="col draw" pathLength="1" style={`--d:${1 + i * 0.1}s`} />
    ))}
    {[350, 290, 230, 170, 110].map((y, i) => (
      <line x1="86" y1={y} x2="474" y2={y} class="slab draw" pathLength="1" style={`--d:${1.6 + i * 0.2}s`} />
    ))}
    <path d="M86 110 v-14 M474 110 v-14" class="slab-thin draw" pathLength="1" style="--d:2.6s" />
    <rect x="214" y="110" width="12" height="298" class="shear fade" style="--d:2.7s" />
    <g class="fade" style="--d:3.0s">
      <line x1="508" y1="110" x2="508" y2="408" class="dim" />
      <path d="M504 114 l8 -8 M504 174 l8 -8 M504 234 l8 -8 M504 294 l8 -8 M504 354 l8 -8 M504 412 l8 -8" class="dim" />
      <text x="524" y="144" class="dim-t v">3.00</text><text x="524" y="204" class="dim-t v">3.00</text>
      <text x="524" y="264" class="dim-t v">3.00</text><text x="524" y="324" class="dim-t v">3.00</text>
      <text x="524" y="383" class="dim-t v">2.90</text>
    </g>
    <g class="fade" style="--d:3.2s">
      <path d="M40 110 l8 -10 h-16z" class="kot" /><text x="36" y="94" class="note">+15.00</text>
      <path d="M40 430 l8 -10 h-16z" class="kot" /><text x="36" y="414" class="note">±0.00</text>
    </g>
    <g class="fade" style="--d:3.3s">
      <circle cx="300" cy="468" r="17" class="pipe" /><circle cx="300" cy="468" r="11" class="pipe-in" />
      <rect x="324" y="459" width="108" height="18" class="label-bg" />
      <text x="330" y="472" class="note accent">{d.pipe}</text>
    </g>
    <g class="fade" style="--d:3.4s">
      <path d="M300 230 L352 200 H446" class="leader" /><circle cx="300" cy="230" r="3" class="leader-dot" />
      <text x="354" y="195" class="note">K-301 · 30/60</text>
      <path d="M226 320 L244 380 H346" class="leader" /><circle cx="226" cy="320" r="3" class="leader-dot" />
      <text x="248" y="375" class="note accent">{d.wall}</text>
    </g>
    </g>
    <g class="structure-3d" aria-hidden="true">
      <path d="M82 408 L422 408 L474 374 L134 374 Z" class="frame-foundation" />
      <path d="M105 384 L430 384 L470 354 L145 354 Z" class="floor-slab frame-trace" pathLength="1" style="--trace-delay:3.8s" />
      <path d="M105 324 L430 324 L470 294 L145 294 Z" class="floor-slab frame-trace" pathLength="1" style="--trace-delay:4s" />
      <path d="M105 264 L430 264 L470 234 L145 234 Z" class="floor-slab frame-trace" pathLength="1" style="--trace-delay:4.2s" />
      <path d="M105 204 L430 204 L470 174 L145 174 Z" class="floor-slab frame-trace" pathLength="1" style="--trace-delay:4.4s" />
      <path d="M105 144 L430 144 L470 114 L145 114 Z" class="floor-slab frame-trace" pathLength="1" style="--trace-delay:4.6s" />

      <g class="concrete-frame" filter="url(#frame-glow)">
        {[110, 216, 322, 428].map((x, i) => (
          <>
            <path d={`M${x} 384 V144`} class="concrete-member frame-trace" pathLength="1" style={`--trace-delay:${3.7 + i * 0.1}s`} />
            <path d={`M${x + 40} 354 V114`} class="concrete-back frame-trace" pathLength="1" style={`--trace-delay:${4.1 + i * 0.1}s`} />
          </>
        ))}
        {[384, 324, 264, 204, 144].map((y, i) => (
          <>
            <path d={`M110 ${y} H430`} class="concrete-member frame-trace" pathLength="1" style={`--trace-delay:${3.8 + i * 0.12}s`} />
            <path d={`M150 ${y - 30} H470`} class="concrete-back frame-trace" pathLength="1" style={`--trace-delay:${4 + i * 0.12}s`} />
            <path d={`M110 ${y} L150 ${y - 30} M430 ${y} L470 ${y - 30}`} class="concrete-side frame-trace" pathLength="1" style={`--trace-delay:${4.2 + i * 0.12}s`} />
          </>
        ))}
      </g>
      <g class="reinforcement">
        {[110, 216, 322, 428].map((x) => (
          <>
            <path d={`M${x - 3} 378 V150 M${x + 3} 378 V150`} class="rebar" />
            {[174, 234, 294, 354].map((y) => <path d={`M${x - 5} ${y} H${x + 5}`} class="stirrup" />)}
          </>
        ))}
        {[150, 256, 362, 468].map((x) => <path d={`M${x} 348 V120`} class="rebar back" />)}
      </g>
      <path d="M88 414 L424 414 L484 376" class="frame-highlight" />
      <text x="92" y="448" class="frame-label">BETONARME KARKAS · 4 KAT</text>
      <circle cx="472" cy="448" r="3" class="frame-status" />
      <text x="484" y="452" class="frame-status-text">TAMAMLANDI</text>
    </g>
  </svg>
  <figcaption class="caption"><span>{d.section}</span><span>{d.scale}</span></figcaption>
</figure>

<style>
  .hero-drawing {
    position: relative;
    margin: 0;
    padding: clamp(8px, 1.5vw, 14px);
    overflow: hidden;
    border: 1px solid var(--line);
    background: transparent;
    box-shadow: none;
  }

  .hero-drawing::before {
    display: none;
  }

  .frame-svg { position: relative; z-index: 1; width: 100%; height: auto; overflow: visible; }
  .caption { position: relative; z-index: 1; color: var(--muted); border-color: var(--line); }
  .blueprint { animation: blueprint-exit .8s ease-in 4.6s forwards; }
  .structure-3d {
    opacity: 0;
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: frame-appear 1.1s cubic-bezier(.2, .7, .1, 1) 3.65s forwards;
  }
  .frame-foundation { fill: color-mix(in srgb, var(--ink) 12%, transparent); stroke: var(--ink-soft); stroke-width: 1.5; }
  .floor-slab { fill: url(#floor-fill); stroke: color-mix(in srgb, var(--accent) 70%, var(--ink)); stroke-width: 1.4; }
  .concrete-member { fill: none; stroke: url(#concrete-front); stroke-width: 8; stroke-linecap: square; }
  .concrete-back { fill: none; stroke: #7090ac; stroke-width: 6; stroke-linecap: square; }
  .concrete-side { fill: none; stroke: #4f6a85; stroke-width: 5; stroke-linecap: square; }
  .reinforcement { opacity: .9; }
  .rebar { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .rebar.back { stroke: var(--accent); stroke-width: 1.1; opacity: .6; }
  .stirrup { fill: none; stroke: var(--accent); stroke-width: 1.2; opacity: .82; }
  .frame-highlight { fill: none; stroke: var(--line-strong); stroke-width: 1.2; opacity: .85; }
  .frame-label { fill: var(--muted); font: 500 10px var(--f-mono); letter-spacing: .12em; }
  .frame-status { fill: var(--ok); }
  .frame-status-text { fill: var(--ok); font: 600 8px var(--f-mono); letter-spacing: .12em; }
  .frame-trace { stroke-dasharray: 1; stroke-dashoffset: 1; animation: trace-frame 1.25s ease-out var(--trace-delay, 3.8s) forwards; }

  @keyframes trace-frame { to { stroke-dashoffset: 0; } }
  @keyframes blueprint-exit { to { opacity: 0; } }
  @keyframes frame-appear {
    from { opacity: 0; transform: perspective(900px) rotateY(-9deg) rotateX(5deg) translateY(14px); }
    to { opacity: 1; transform: perspective(900px) rotateY(0) rotateX(0) translateY(0); }
  }
  @keyframes light-sweep {
    from { transform: translateX(-100%); opacity: 0; }
    20%, 80% { opacity: 1; }
    to { transform: translateX(100%); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-drawing::before { animation: none; }
    .blueprint { animation: none; opacity: 0; }
    .structure-3d { animation: none; opacity: 1; transform: none; }
    .frame-trace { animation: none; stroke-dasharray: none; stroke-dashoffset: 0; }
  }
</style>
