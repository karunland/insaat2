---
import { projectPath, useT, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const r = t.home.renovation;

const allProjects = await getProjects(lang);
const byId = new Map(allProjects.map((p) => [p.id, p]));

const slides = [
  {
    slug: 'altinboynuz-tesisleri',
    title: byId.get('altinboynuz-tesisleri')?.text.baslik ?? 'Haliç Altınboynuz Sosyal Tesisleri ve Kıyı Düzenlemesi',
    href: projectPath(lang, 'altinboynuz-tesisleri'),
    src: '/assets/aistudio/gemini_generated_video_9b3b5cb3_e95d0ef8.mp4',
    poster: '/assets/aistudio/renovation_end_poster.webp',
    masked: true,
  },
  {
    slug: 'bostanci-kentsel-donusum',
    title: byId.get('bostanci-kentsel-donusum')?.text.baslik ?? 'Bostancı Mahallesi Kentsel Dönüşüm Projesi',
    href: projectPath(lang, 'bostanci-kentsel-donusum'),
    src: '/assets/aistudio/bostanci_kentsel_donusum.mp4',
    poster: '/assets/aistudio/bostanci_end_poster.jpg',
    masked: false,
  },
];

const slidesMeta = slides.map(({ title, href }) => ({ title, href }));
---

<div class="intro-backdrop" id="introBackdrop" aria-hidden="true"></div>

<div class="intro-mover" id="introMover" aria-hidden="true"></div>

<div
  class="intro-chrome"
  id="introChrome"
  role="dialog"
  aria-modal="true"
  aria-label={r.sheetLabel}
>
  <div class="intro-top">
    <div class="intro-mark">
      <svg class="intro-logo" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" class="bm-bg" />
        <path d="M8 8h16v3h-6.5v10H24v3H8v-3h6.5V11H8z" class="bm-beam" />
      </svg>
      <span class="intro-sheet">{r.sheetLabel}</span>
    </div>

    <button
      type="button"
      class="intro-skip"
      id="introSkip"
      aria-label={r.skipAria}
    >
      <span>{r.skip}</span>
      <span class="intro-skip-arrow" aria-hidden="true">→</span>
    </button>
  </div>

  <div class="intro-bottom">
    <div class="intro-progress-wrap">
      <div class="intro-track" aria-hidden="true">
        <div class="intro-fill" id="introProgressFill"></div>
      </div>
      <ol class="intro-phases" id="introPhases">
        {r.phases.map((label, i) => (
          <li class="intro-phase" data-phase-idx={i} data-state={i === 0 ? 'active' : 'pending'}>
            <span class="phase-num">0{i + 1}</span>
            <span class="phase-name">{label}</span>
          </li>
        ))}
      </ol>
      <div class="intro-mobile-row">
        <span class="intro-mobile-phase" id="introMobilePhase">01 · {r.phases[0]}</span>
      </div>
    </div>
  </div>
</div>

<figure
  class="hero-drawing hero-renovation"
  id="heroRenovation"
  aria-label={t.home.drawingAria}
  data-phases={JSON.stringify(r.phases)}
  data-slides={JSON.stringify(slidesMeta)}
>
  <div class="hero-video-slot" id="heroVideoSlot">
    <div class="hero-slider-track" id="heroSliderTrack">
      {slides.map((slide, idx) => (
        <div class:list={['hero-slide', { 'is-masked': slide.masked }]} data-slide={idx}>
          <div class="hero-slide-media" id={`heroSlideSlot${idx}`}>
            <video
              id={idx === 0 ? 'renovationVideo' : `renovationVideo${idx}`}
              class:list={['renovation-video', { 'renovation-video--masked': slide.masked }]}
              src={slide.src}
              poster={slide.poster}
              muted
              playsinline
              preload={idx === 0 ? 'auto' : 'metadata'}
              disablepictureinpicture
            ></video>
          </div>
          <a
            class="hero-slide-overlay"
            href={slide.href}
            aria-label={`${slide.title} — ${r.viewProject}`}
            tabindex="-1"
          ></a>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-progress-track" aria-hidden="true">
    <div class="hero-progress-fill" id="heroProgressFill"></div>
  </div>

  <figcaption class="caption hero-renovation-caption">
    <a class="hero-project-link" id="heroProjectLink" href={slides[0].href} title={r.viewProject}>
      <span class="hero-project-title" id="heroProjectTitle">{slides[0].title}</span>
      <span class="hero-project-arrow" aria-hidden="true">↗</span>
    </a>

    <div class="hero-slider-controls">
      <button type="button" class="hero-nav-btn" id="heroPrev" aria-label={r.prevAria}>
        <span aria-hidden="true">←</span>
      </button>
      <div class="hero-dots" id="heroDots">
        {slides.map((slide, idx) => (
          <button
            type="button"
            class:list={['hero-dot', { 'is-active': idx === 0 }]}
            data-dot={idx}
            aria-label={slide.title}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>
      <button type="button" class="hero-nav-btn" id="heroNext" aria-label={r.nextAria}>
        <span aria-hidden="true">→</span>
      </button>
      <button
        type="button"
        class="hero-replay-btn"
        id="heroReplay"
        aria-label={r.replayAria}
        title={r.replay}
      >
        <svg class="replay-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
          <path d="M2.75 7.5A5.25 5.25 0 1 1 4.4 11.4" />
          <path d="M2.5 3.5v4h4" />
        </svg>
      </button>
    </div>
  </figcaption>
</figure>

<script is:inline>
  // Move video synchronously into the splash mover before first paint when splash is active
  (function () {
    if (document.documentElement.getAttribute('data-intro') === 'splash') {
      var mover = document.getElementById('introMover');
      var video = document.getElementById('renovationVideo');
      if (mover && video) {
        video.removeAttribute('poster');
        mover.appendChild(video);
      }
    }
  })();
</script>

<script>
  (function () {
    const STORAGE_KEY = 'maksef-intro-seen';
    const PHASE_STARTS = [0, 0.22, 0.45, 0.72];
    const PLAYBACK_RATE = 1.6;
    const REPLAY_RATE = 1.35;
    const SPLASH_DOCK_RATIO = 0.28;
    const AUTO_SLIDE_DELAY = 1400;

    const root = document.documentElement;
    const figure = document.getElementById('heroRenovation');
    const slot = document.getElementById('heroVideoSlot');
    const track = document.getElementById('heroSliderTrack');
    const slideSlot0 = document.getElementById('heroSlideSlot0');
    const video0 = document.getElementById('renovationVideo') as HTMLVideoElement | null;
    const backdrop = document.getElementById('introBackdrop');
    const mover = document.getElementById('introMover');
    const chrome = document.getElementById('introChrome');
    const skipBtn = document.getElementById('introSkip');
    const progressFill = document.getElementById('introProgressFill');
    const mobilePhaseEl = document.getElementById('introMobilePhase');
    const phaseItems = Array.from(document.querySelectorAll<HTMLLIElement>('#introPhases .intro-phase'));
    const replayBtn = document.getElementById('heroReplay');
    const prevBtn = document.getElementById('heroPrev');
    const nextBtn = document.getElementById('heroNext');
    const dotBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#heroDots .hero-dot'));
    const projectLink = document.getElementById('heroProjectLink') as HTMLAnchorElement | null;
    const projectTitle = document.getElementById('heroProjectTitle');
    const heroProgressFill = document.getElementById('heroProgressFill');

    if (!figure || !slot || !track || !slideSlot0 || !video0 || !backdrop || !mover || !chrome) return;

    const videos = Array.from(figure.querySelectorAll<HTMLVideoElement>('.renovation-video'));
    if (!videos.includes(video0)) {
      videos.unshift(video0);
    }

    const slidesMeta: { title: string; href: string }[] = (() => {
      try {
        return JSON.parse(figure.dataset.slides || '[]');
      } catch {
        return [];
      }
    })();

    const phases: string[] = (() => {
      try {
        return JSON.parse(figure.dataset.phases || '[]');
      } catch {
        return [];
      }
    })();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const initialMode = root.getAttribute('data-intro');
    let state: 'splash' | 'transitioning' | 'docked' = initialMode === 'splash' && !reduceMotion ? 'splash' : 'docked';

    let activeIdx = 0;
    let splashRaf = 0;
    let replayRaf = 0;
    let autoSlideTimer = 0;
    let isHovered = false;
    let touchStartY = 0;
    let swipeStartX = 0;
    let swipeStartY = 0;
    let didSwipe = false;
    let hasStartedPlayback = false;
    let activeFlipAnim: Animation | null = null;

    function getActiveVideo(): HTMLVideoElement | null {
      return videos[activeIdx] ?? video0;
    }

    function getPhaseIndex(ratio: number): number {
      let idx = 0;
      for (let i = 0; i < PHASE_STARTS.length; i++) {
        if (ratio >= PHASE_STARTS[i]) idx = i;
      }
      return idx;
    }

    function seekToFinalFrame(vid: HTMLVideoElement | null = getActiveVideo()) {
      if (!vid) return;
      vid.pause();
      const applyEnd = () => {
        if (Number.isFinite(vid.duration) && vid.duration > 0) {
          const target = Math.max(0, vid.duration - 0.06);
          if (Math.abs(vid.currentTime - target) > 0.04) {
            try {
              vid.currentTime = target;
            } catch {
              // Ignore seek errors on unloaded media
            }
          }
        }
      };
      if (vid.readyState >= 1) {
        applyEnd();
      } else {
        vid.addEventListener('loadedmetadata', applyEnd, { once: true });
      }
    }

    function hideSplashElements() {
      backdrop!.hidden = true;
      mover!.hidden = true;
      chrome!.hidden = true;
    }

    function updateSplashUI(ratio: number) {
      const clamped = Math.max(0, Math.min(1, ratio));
      if (progressFill) {
        progressFill.style.transform = `scaleX(${clamped.toFixed(4)})`;
      }
      const activePhaseIdx = getPhaseIndex(clamped);
      phaseItems.forEach((item, idx) => {
        const nextState = idx < activePhaseIdx ? 'done' : idx === activePhaseIdx ? 'active' : 'pending';
        if (item.dataset.state !== nextState) {
          item.dataset.state = nextState;
        }
      });
      if (mobilePhaseEl && phases[activePhaseIdx]) {
        const text = `0${activePhaseIdx + 1} · ${phases[activePhaseIdx]}`;
        if (mobilePhaseEl.textContent !== text) mobilePhaseEl.textContent = text;
      }
    }

    function clearAutoSlide() {
      if (autoSlideTimer) {
        window.clearTimeout(autoSlideTimer);
        autoSlideTimer = 0;
      }
    }

    function scheduleAutoSlide() {
      clearAutoSlide();
      if (state !== 'docked' || reduceMotion || videos.length < 2 || isHovered) return;
      autoSlideTimer = window.setTimeout(() => {
        goToSlide((activeIdx + 1) % videos.length, true);
      }, AUTO_SLIDE_DELAY);
    }

    function finishDocking(continuePlaying: boolean) {
      if (activeFlipAnim) {
        try {
          activeFlipAnim.cancel();
        } catch {
          // Ignore
        }
        activeFlipAnim = null;
      }

      const resumeTime = video0!.currentTime || 0;
      if (video0!.parentElement !== slideSlot0) {
        slideSlot0!.appendChild(video0!);
      }
      hideSplashElements();
      mover!.removeAttribute('style');
      root.setAttribute('data-intro', 'docked');
      state = 'docked';

      const dur = Number.isFinite(video0!.duration) && video0!.duration > 0 ? video0!.duration : 10;
      if (continuePlaying && !reduceMotion && !video0!.ended && resumeTime < dur - 0.12) {
        video0!.defaultPlaybackRate = REPLAY_RATE;
        video0!.playbackRate = REPLAY_RATE;
        figure!.classList.add('is-replaying');
        const p = video0!.play();
        if (p && typeof p.then === 'function') {
          p.then(() => {
            video0!.playbackRate = REPLAY_RATE;
            replayRaf = requestAnimationFrame(tickReplayProgress);
          }).catch(() => {
            stopReplayUI();
            seekToFinalFrame(video0);
            scheduleAutoSlide();
          });
        } else {
          replayRaf = requestAnimationFrame(tickReplayProgress);
        }
      } else {
        seekToFinalFrame(video0);
        scheduleAutoSlide();
      }
    }

    function cleanupSplashListeners() {
      window.removeEventListener('wheel', onSplashWheel);
      window.removeEventListener('touchstart', onSplashTouchStart);
      window.removeEventListener('touchmove', onSplashTouchMove);
      window.removeEventListener('keydown', onSplashKeyDown);
      video0?.removeEventListener('ended', onSplashVideoEnded);
    }

    function dockIntoHero(skipped: boolean) {
      if (state !== 'splash') return;
      state = 'transitioning';
      cancelAnimationFrame(splashRaf);
      cleanupSplashListeners();

      try {
        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch {
        // Ignore storage restrictions
      }

      const continuePlaying = !reduceMotion && !video0!.ended;
      if (reduceMotion) {
        video0!.pause();
        seekToFinalFrame(video0);
      } else if (skipped && video0!.paused) {
        video0!.play().catch(() => {});
      }

      chrome!.classList.add('is-leaving');

      const fromRect = mover!.getBoundingClientRect();
      const toRect = slot!.getBoundingClientRect();

      if (reduceMotion || fromRect.width === 0 || toRect.width === 0 || typeof mover!.animate !== 'function') {
        finishDocking(continuePlaying);
        return;
      }

      mover!.style.left = `${fromRect.left}px`;
      mover!.style.top = `${fromRect.top}px`;
      mover!.style.width = `${fromRect.width}px`;
      mover!.style.height = `${fromRect.height}px`;
      mover!.style.transform = 'none';

      const dx = (toRect.left + toRect.width / 2) - (fromRect.left + fromRect.width / 2);
      const dy = (toRect.top + toRect.height / 2) - (fromRect.top + fromRect.height / 2);
      const scale = toRect.width / fromRect.width;

      backdrop!.classList.add('is-fading');

      const duration = 760;
      activeFlipAnim = mover!.animate(
        [
          { transform: 'translate3d(0px, 0px, 0px) scale(1)' },
          { transform: `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0px) scale(${scale.toFixed(4)})` },
        ],
        {
          duration,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );

      let settled = false;
      const onDone = () => {
        if (settled) return;
        settled = true;
        finishDocking(continuePlaying);
      };

      activeFlipAnim.finished.then(onDone, onDone);
      window.setTimeout(onDone, duration + 140);
    }

    function onSplashVideoEnded() {
      dockIntoHero(false);
    }

    function onSplashWheel(e: WheelEvent) {
      if (e.deltaY > 10) {
        dockIntoHero(true);
      }
    }

    function onSplashTouchStart(e: TouchEvent) {
      if (e.touches.length) touchStartY = e.touches[0].clientY;
    }

    function onSplashTouchMove(e: TouchEvent) {
      if (!e.touches.length) return;
      if (touchStartY - e.touches[0].clientY > 28) {
        dockIntoHero(true);
      }
    }

    function onSplashKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape' || e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        dockIntoHero(true);
      }
    }

    function tickSplashProgress() {
      if (state !== 'splash' || !video0) return;
      const dur = Number.isFinite(video0.duration) && video0.duration > 0 ? video0.duration : 10;
      const cur = video0.currentTime || 0;
      if (cur > 0.05) hasStartedPlayback = true;
      const ratio = cur / dur;
      updateSplashUI(ratio);

      if (video0.ended || (hasStartedPlayback && dur > 0 && ratio >= SPLASH_DOCK_RATIO)) {
        dockIntoHero(false);
        return;
      }
      splashRaf = requestAnimationFrame(tickSplashProgress);
    }

    /* ---------- Docked Slider & Replay Flow ---------- */
    function stopReplayUI() {
      cancelAnimationFrame(replayRaf);
      figure!.classList.remove('is-replaying');
      if (heroProgressFill) heroProgressFill.style.transform = 'scaleX(0)';
    }

    function tickReplayProgress() {
      const vid = getActiveVideo();
      if (state !== 'docked' || !vid || vid.paused) return;
      const dur = Number.isFinite(vid.duration) && vid.duration > 0 ? vid.duration : 10;
      const ratio = Math.max(0, Math.min(1, vid.currentTime / dur));
      if (heroProgressFill) {
        heroProgressFill.style.transform = `scaleX(${ratio.toFixed(4)})`;
      }
      if (vid.ended || ratio >= 0.994) {
        seekToFinalFrame(vid);
        stopReplayUI();
        scheduleAutoSlide();
        return;
      }
      replayRaf = requestAnimationFrame(tickReplayProgress);
    }

    function startDockedReplay(rate?: number) {
      const vid = getActiveVideo();
      if (state !== 'docked' || !vid) return;
      clearAutoSlide();
      cancelAnimationFrame(replayRaf);
      const targetRate = typeof rate === 'number' ? rate : REPLAY_RATE;
      vid.muted = true;
      vid.playsInline = true;
      vid.defaultPlaybackRate = targetRate;
      vid.playbackRate = targetRate;
      try {
        vid.currentTime = 0;
      } catch {
        // Ignore
      }
      figure!.classList.add('is-replaying');

      const p = vid.play();
      if (p && typeof p.then === 'function') {
        p.then(() => {
          vid.playbackRate = targetRate;
          replayRaf = requestAnimationFrame(tickReplayProgress);
        }).catch(() => {
          stopReplayUI();
          seekToFinalFrame(vid);
          scheduleAutoSlide();
        });
      } else {
        replayRaf = requestAnimationFrame(tickReplayProgress);
      }
    }

    function goToSlide(nextIdx: number, autoPlay = true) {
      if (state !== 'docked' || videos.length < 2) return;
      const clamped = (nextIdx + videos.length) % videos.length;
      if (clamped === activeIdx && !autoPlay) return;

      clearAutoSlide();
      stopReplayUI();
      const prevVid = getActiveVideo();
      if (prevVid) prevVid.pause();

      activeIdx = clamped;
      track!.style.transform = `translate3d(-${activeIdx * 100}%, 0, 0)`;

      const meta = slidesMeta[activeIdx];
      if (meta && projectLink && projectTitle) {
        projectLink.href = meta.href;
        projectTitle.textContent = meta.title;
      }

      dotBtns.forEach((btn, i) => {
        const on = i === activeIdx;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      });

      const nextVid = getActiveVideo();
      if (!nextVid) return;

      if (autoPlay && !reduceMotion) {
        if (nextVid.readyState >= 2) {
          startDockedReplay(REPLAY_RATE);
        } else {
          nextVid.preload = 'auto';
          if (nextVid.readyState === 0) nextVid.load();
          let started = false;
          const playOnce = () => {
            if (started || getActiveVideo() !== nextVid) return;
            started = true;
            startDockedReplay(REPLAY_RATE);
          };
          nextVid.addEventListener('canplay', playOnce, { once: true });
          window.setTimeout(playOnce, 300);
        }
      } else {
        seekToFinalFrame(nextVid);
        scheduleAutoSlide();
      }
    }

    replayBtn?.addEventListener('click', () => startDockedReplay(REPLAY_RATE));
    prevBtn?.addEventListener('click', () => goToSlide(activeIdx - 1, true));
    nextBtn?.addEventListener('click', () => goToSlide(activeIdx + 1, true));
    dotBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => goToSlide(idx, true));
    });

    const captionBar = figure.querySelector('.hero-renovation-caption');
    captionBar?.addEventListener('mouseenter', () => {
      isHovered = true;
      clearAutoSlide();
    });
    captionBar?.addEventListener('mouseleave', () => {
      isHovered = false;
      const vid = getActiveVideo();
      if (state === 'docked' && vid && vid.paused) {
        scheduleAutoSlide();
      }
    });

    // Touch swipe support on the slider slot
    slot.addEventListener('touchstart', (e) => {
      if (state !== 'docked' || !e.touches.length) return;
      swipeStartX = e.touches[0].clientX;
      swipeStartY = e.touches[0].clientY;
      didSwipe = false;
    }, { passive: true });

    slot.addEventListener('touchend', (e) => {
      if (state !== 'docked' || !e.changedTouches.length) return;
      const dx = e.changedTouches[0].clientX - swipeStartX;
      const dy = e.changedTouches[0].clientY - swipeStartY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        didSwipe = true;
        goToSlide(dx < 0 ? activeIdx + 1 : activeIdx - 1, true);
      }
    }, { passive: true });

    slot.addEventListener('click', (e) => {
      if (didSwipe) {
        e.preventDefault();
        didSwipe = false;
      }
    });

    videos.forEach((vid, idx) => {
      vid.addEventListener('ended', () => {
        if (state === 'docked' && idx === activeIdx) {
          seekToFinalFrame(vid);
          stopReplayUI();
          scheduleAutoSlide();
        }
      });
    });

    /* ---------- Boot ---------- */
    video0.defaultPlaybackRate = PLAYBACK_RATE;
    video0.playbackRate = PLAYBACK_RATE;

    if (state === 'splash') {
      window.scrollTo(0, 0);
      if (video0.parentElement !== mover) {
        video0.removeAttribute('poster');
        mover.appendChild(video0);
      }

      video0.muted = true;
      video0.playsInline = true;
      video0.loop = false;
      video0.defaultPlaybackRate = PLAYBACK_RATE;
      video0.playbackRate = PLAYBACK_RATE;
      video0.currentTime = 0;

      skipBtn?.addEventListener('click', () => dockIntoHero(true));
      video0.addEventListener('ended', onSplashVideoEnded);
      window.addEventListener('wheel', onSplashWheel, { passive: true });
      window.addEventListener('touchstart', onSplashTouchStart, { passive: true });
      window.addEventListener('touchmove', onSplashTouchMove, { passive: true });
      window.addEventListener('keydown', onSplashKeyDown);

      const playPromise = video0.play();
      if (playPromise && typeof playPromise.then === 'function') {
        playPromise.then(() => {
          video0.playbackRate = PLAYBACK_RATE;
        }).catch(() => {
          const resumeOrSkip = () => {
            if (state !== 'splash') return;
            video0.playbackRate = PLAYBACK_RATE;
            video0.play().catch(() => dockIntoHero(true));
          };
          chrome.addEventListener('pointerdown', resumeOrSkip, { once: true });
        });
      }
      splashRaf = requestAnimationFrame(tickSplashProgress);
    } else {
      if (video0.parentElement !== slideSlot0) {
        slideSlot0.appendChild(video0);
      }
      hideSplashElements();
      root.setAttribute('data-intro', 'docked');
      if (reduceMotion) {
        seekToFinalFrame(video0);
      } else {
        let started = false;
        const playDockedIntro = () => {
          if (started) return;
          started = true;
          startDockedReplay(REPLAY_RATE);
        };
        if (video0.readyState >= 2) {
          playDockedIntro();
        } else {
          video0.addEventListener('canplay', playDockedIntro, { once: true });
          window.setTimeout(playDockedIntro, 150);
        }
      }
    }
  })();
</script>

<style is:global>
  /* ---------- Splash visibility & scroll lock ---------- */
  html[data-intro="splash"] body {
    overflow: hidden;
  }

  html:not([data-intro="splash"]) .intro-backdrop,
  html:not([data-intro="splash"]) .intro-mover,
  html:not([data-intro="splash"]) .intro-chrome {
    display: none;
  }

  /* Hide docked placeholder frame until the video lands */
  html[data-intro="splash"] .hero-renovation .hero-renovation-caption,
  html[data-intro="splash"] .hero-renovation .hero-progress-track {
    opacity: 0;
  }

