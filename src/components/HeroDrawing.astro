---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const r = t.home.renovation;
const videoSrc = '/assets/aistudio/gemini_generated_video_9b3b5cb3_e95d0ef8.mp4';
const posterSrc = '/assets/aistudio/renovation_end_poster.webp';
---

<div class="intro-backdrop" id="introBackdrop" aria-hidden="true"></div>

<div class="intro-mover" id="introMover" aria-hidden="true"></div>

<div
  class="intro-chrome"
  id="introChrome"
  role="dialog"
  aria-modal="true"
  aria-label={r.sheetLabel}
>
  <div class="intro-top">
    <div class="intro-mark">
      <svg class="intro-logo" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" class="bm-bg" />
        <path d="M8 8h16v3h-6.5v10H24v3H8v-3h6.5V11H8z" class="bm-beam" />
      </svg>
      <span class="intro-sheet">{r.sheetLabel}</span>
    </div>

    <button
      type="button"
      class="intro-skip"
      id="introSkip"
      aria-label={r.skipAria}
    >
      <span>{r.skip}</span>
      <span class="intro-skip-arrow" aria-hidden="true">→</span>
    </button>
  </div>

  <div class="intro-bottom">
    <div class="intro-progress-wrap">
      <div class="intro-track" aria-hidden="true">
        <div class="intro-fill" id="introProgressFill"></div>
      </div>
      <ol class="intro-phases" id="introPhases">
        {r.phases.map((label, i) => (
          <li class="intro-phase" data-phase-idx={i} data-state={i === 0 ? 'active' : 'pending'}>
            <span class="phase-num">0{i + 1}</span>
            <span class="phase-name">{label}</span>
          </li>
        ))}
      </ol>
      <div class="intro-mobile-row">
        <span class="intro-mobile-phase" id="introMobilePhase">01 · {r.phases[0]}</span>
        <span class="intro-scroll-hint">{r.scrollHint}</span>
      </div>
    </div>
  </div>
</div>

<figure
  class="hero-drawing hero-renovation"
  id="heroRenovation"
  aria-label={t.home.drawingAria}
  data-caption-default={r.captionLeft}
  data-phases={JSON.stringify(r.phases)}
>
  <div class="hero-video-slot" id="heroVideoSlot">
    <video
      id="renovationVideo"
      class="renovation-video"
      src={videoSrc}
      poster={posterSrc}
      muted
      playsinline
      preload="auto"
      disablepictureinpicture
    ></video>
  </div>

  <div class="hero-progress-track" aria-hidden="true">
    <div class="hero-progress-fill" id="heroProgressFill"></div>
  </div>

  <figcaption class="caption hero-renovation-caption">
    <span class="hero-phase-label" id="heroPhaseLabel">{r.captionLeft}</span>
    <button
      type="button"
      class="hero-replay-btn"
      id="heroReplay"
      aria-label={r.replayAria}
    >
      <svg class="replay-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
        <path d="M2.75 7.5A5.25 5.25 0 1 1 4.4 11.4" />
        <path d="M2.5 3.5v4h4" />
      </svg>
      <span>{r.replay}</span>
    </button>
  </figcaption>
</figure>

<script is:inline>
  // Move video synchronously into the splash mover before first paint when splash is active
  (function () {
    if (document.documentElement.getAttribute('data-intro') === 'splash') {
      var mover = document.getElementById('introMover');
      var video = document.getElementById('renovationVideo');
      if (mover && video) {
        video.removeAttribute('poster');
        mover.appendChild(video);
      }
    }
  })();
</script>

<script>
  (function () {
    const STORAGE_KEY = 'maksef-intro-seen';
    const PHASE_STARTS = [0, 0.22, 0.45, 0.72];

    const root = document.documentElement;
    const figure = document.getElementById('heroRenovation');
    const slot = document.getElementById('heroVideoSlot');
    const video = document.getElementById('renovationVideo') as HTMLVideoElement | null;
    const backdrop = document.getElementById('introBackdrop');
    const mover = document.getElementById('introMover');
    const chrome = document.getElementById('introChrome');
    const skipBtn = document.getElementById('introSkip');
    const progressFill = document.getElementById('introProgressFill');
    const mobilePhaseEl = document.getElementById('introMobilePhase');
    const phaseItems = Array.from(document.querySelectorAll<HTMLLIElement>('#introPhases .intro-phase'));
    const replayBtn = document.getElementById('heroReplay');
    const heroProgressFill = document.getElementById('heroProgressFill');
    const heroPhaseLabel = document.getElementById('heroPhaseLabel');

    if (!figure || !slot || !video || !backdrop || !mover || !chrome) return;

    const defaultCaption = figure.dataset.captionDefault || '';
    const phases: string[] = (() => {
      try {
        return JSON.parse(figure.dataset.phases || '[]');
      } catch {
        return [];
      }
    })();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const initialMode = root.getAttribute('data-intro');
    let state: 'splash' | 'transitioning' | 'docked' = initialMode === 'splash' && !reduceMotion ? 'splash' : 'docked';

    let splashRaf = 0;
    let replayRaf = 0;
    let touchStartY = 0;
    let hasStartedPlayback = false;
    let activeFlipAnim: Animation | null = null;

    function getPhaseIndex(ratio: number): number {
      let idx = 0;
      for (let i = 0; i < PHASE_STARTS.length; i++) {
        if (ratio >= PHASE_STARTS[i]) idx = i;
      }
      return idx;
    }

    function seekToFinalFrame() {
      if (!video) return;
      video.pause();
      const applyEnd = () => {
        if (Number.isFinite(video.duration) && video.duration > 0) {
          const target = Math.max(0, video.duration - 0.06);
          if (Math.abs(video.currentTime - target) > 0.04) {
            try {
              video.currentTime = target;
            } catch {
              // Ignore seek errors on unloaded media
            }
          }
        }
      };
      if (video.readyState >= 1) {
        applyEnd();
      } else {
        video.addEventListener('loadedmetadata', applyEnd, { once: true });
      }
    }

    function hideSplashElements() {
      backdrop!.hidden = true;
      mover!.hidden = true;
      chrome!.hidden = true;
    }

    function updateSplashUI(ratio: number) {
      const clamped = Math.max(0, Math.min(1, ratio));
      if (progressFill) {
        progressFill.style.transform = `scaleX(${clamped.toFixed(4)})`;
      }
      const activeIdx = getPhaseIndex(clamped);
      phaseItems.forEach((item, idx) => {
        const nextState = idx < activeIdx ? 'done' : idx === activeIdx ? 'active' : 'pending';
        if (item.dataset.state !== nextState) {
          item.dataset.state = nextState;
        }
      });
      if (mobilePhaseEl && phases[activeIdx]) {
        const text = `0${activeIdx + 1} · ${phases[activeIdx]}`;
        if (mobilePhaseEl.textContent !== text) mobilePhaseEl.textContent = text;
      }
    }

    function finishDocking() {
      if (activeFlipAnim) {
        try {
          activeFlipAnim.cancel();
        } catch {
          // Ignore
        }
        activeFlipAnim = null;
      }

      if (video!.parentElement !== slot) {
        slot!.appendChild(video!);
      }
      seekToFinalFrame();
      hideSplashElements();
      mover!.removeAttribute('style');
      root.setAttribute('data-intro', 'docked');
      state = 'docked';
    }

    function cleanupSplashListeners() {
      window.removeEventListener('wheel', onSplashWheel);
      window.removeEventListener('touchstart', onSplashTouchStart);
      window.removeEventListener('touchmove', onSplashTouchMove);
      window.removeEventListener('keydown', onSplashKeyDown);
      video?.removeEventListener('ended', onSplashVideoEnded);
    }

    function dockIntoHero(skipped: boolean) {
      if (state !== 'splash') return;
      state = 'transitioning';
      cancelAnimationFrame(splashRaf);
      cleanupSplashListeners();

      try {
        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch {
        // Ignore storage restrictions
      }

      updateSplashUI(1);
      video!.pause();
      if (skipped) {
        seekToFinalFrame();
      }

      chrome!.classList.add('is-leaving');

      // Measure FIRST (current splash video box) and LAST (target Hero slot box)
      const fromRect = mover!.getBoundingClientRect();
      const toRect = slot!.getBoundingClientRect();

      if (reduceMotion || fromRect.width === 0 || toRect.width === 0 || typeof mover!.animate !== 'function') {
        finishDocking();
        return;
      }

      // Pin mover to its exact current viewport box so transform originates cleanly from center
      mover!.style.left = `${fromRect.left}px`;
      mover!.style.top = `${fromRect.top}px`;
      mover!.style.width = `${fromRect.width}px`;
      mover!.style.height = `${fromRect.height}px`;
      mover!.style.transform = 'none';

      const dx = (toRect.left + toRect.width / 2) - (fromRect.left + fromRect.width / 2);
      const dy = (toRect.top + toRect.height / 2) - (fromRect.top + fromRect.height / 2);
      const scale = toRect.width / fromRect.width;

      // Fade out splash backdrop while shrinking and sliding the video straight into the Hero slot
      backdrop!.classList.add('is-fading');

      const duration = 760;
      activeFlipAnim = mover!.animate(
        [
          { transform: 'translate3d(0px, 0px, 0px) scale(1)' },
          { transform: `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0px) scale(${scale.toFixed(4)})` },
        ],
        {
          duration,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );

      let settled = false;
      const onDone = () => {
        if (settled) return;
        settled = true;
        finishDocking();
      };

      activeFlipAnim.finished.then(onDone, onDone);
      window.setTimeout(onDone, duration + 140);
    }

    function onSplashVideoEnded() {
      dockIntoHero(false);
    }

    function onSplashWheel(e: WheelEvent) {
      if (e.deltaY > 10) {
        dockIntoHero(true);
      }
    }

    function onSplashTouchStart(e: TouchEvent) {
      if (e.touches.length) touchStartY = e.touches[0].clientY;
    }

    function onSplashTouchMove(e: TouchEvent) {
      if (!e.touches.length) return;
      if (touchStartY - e.touches[0].clientY > 28) {
        dockIntoHero(true);
      }
    }

    function onSplashKeyDown(e: KeyboardEvent) {
      if (e.key === 'Escape' || e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        dockIntoHero(true);
      }
    }

    function tickSplashProgress() {
      if (state !== 'splash' || !video) return;
      const dur = Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 10;
      const cur = video.currentTime || 0;
      if (cur > 0.05) hasStartedPlayback = true;
      const ratio = cur / dur;
      updateSplashUI(ratio);

      if (video.ended || (hasStartedPlayback && dur > 0 && cur >= dur - 0.06)) {
        dockIntoHero(false);
        return;
      }
      splashRaf = requestAnimationFrame(tickSplashProgress);
    }

    /* ---------- Docked Replay Flow ---------- */
    function stopReplayUI() {
      cancelAnimationFrame(replayRaf);
      figure!.classList.remove('is-replaying');
      if (heroProgressFill) heroProgressFill.style.transform = 'scaleX(0)';
      if (heroPhaseLabel) heroPhaseLabel.textContent = defaultCaption;
    }

    function tickReplayProgress() {
      if (state !== 'docked' || !video || video.paused) return;
      const dur = Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 10;
      const ratio = Math.max(0, Math.min(1, video.currentTime / dur));
      if (heroProgressFill) {
        heroProgressFill.style.transform = `scaleX(${ratio.toFixed(4)})`;
      }
      const idx = getPhaseIndex(ratio);
      if (heroPhaseLabel && phases[idx]) {
        const text = `0${idx + 1} · ${phases[idx]}`;
        if (heroPhaseLabel.textContent !== text) heroPhaseLabel.textContent = text;
      }
      if (video.ended || ratio >= 0.994) {
        seekToFinalFrame();
        stopReplayUI();
        return;
      }
      replayRaf = requestAnimationFrame(tickReplayProgress);
    }

    function startDockedReplay() {
      if (state !== 'docked' || !video) return;
      cancelAnimationFrame(replayRaf);
      video.muted = true;
      video.playsInline = true;
      video.currentTime = 0;
      figure!.classList.add('is-replaying');

      const p = video.play();
      if (p && typeof p.then === 'function') {
        p.then(() => {
          replayRaf = requestAnimationFrame(tickReplayProgress);
        }).catch(() => {
          stopReplayUI();
          seekToFinalFrame();
        });
      } else {
        replayRaf = requestAnimationFrame(tickReplayProgress);
      }
    }

    replayBtn?.addEventListener('click', startDockedReplay);
    video.addEventListener('ended', () => {
      if (state === 'docked') {
        seekToFinalFrame();
        stopReplayUI();
      }
    });

    /* ---------- Boot ---------- */
    if (state === 'splash') {
      window.scrollTo(0, 0);
      if (video.parentElement !== mover) {
        video.removeAttribute('poster');
        mover.appendChild(video);
      }

      video.muted = true;
      video.playsInline = true;
      video.loop = false;
      video.currentTime = 0;

      skipBtn?.addEventListener('click', () => dockIntoHero(true));
      video.addEventListener('ended', onSplashVideoEnded);
      window.addEventListener('wheel', onSplashWheel, { passive: true });
      window.addEventListener('touchstart', onSplashTouchStart, { passive: true });
      window.addEventListener('touchmove', onSplashTouchMove, { passive: true });
      window.addEventListener('keydown', onSplashKeyDown);

      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {
          // If browser blocks autoplay, allow a tap/click on the splash to start or skip
          const resumeOrSkip = () => {
            if (state !== 'splash') return;
            video.play().catch(() => dockIntoHero(true));
          };
          chrome.addEventListener('pointerdown', resumeOrSkip, { once: true });
        });
      }
      splashRaf = requestAnimationFrame(tickSplashProgress);
    } else {
      if (video.parentElement !== slot) {
        slot.appendChild(video);
      }
      hideSplashElements();
      root.setAttribute('data-intro', 'docked');
      seekToFinalFrame();
    }
  })();
</script>

<style is:global>
  /* ---------- Splash visibility & scroll lock ---------- */
  html[data-intro="splash"] body {
    overflow: hidden;
  }

  html:not([data-intro="splash"]) .intro-backdrop,
  html:not([data-intro="splash"]) .intro-mover,
  html:not([data-intro="splash"]) .intro-chrome {
    display: none;
  }

  /* Hide docked placeholder frame until the video lands */
  html[data-intro="splash"] .hero-renovation .hero-renovation-caption,
  html[data-intro="splash"] .hero-renovation .hero-progress-track {
    opacity: 0;
  }

  /* ---------- Full-screen Pafta splash backdrop ---------- */
  .intro-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
    opacity: 1;
    transition: opacity 0.68s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.5s var(--ease);
  }
  .intro-backdrop.is-fading {
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- Centered video mover ---------- */
  .intro-mover {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transform-origin: center center;
    z-index: 105;
    width: min(88vw, 960px, calc((100svh - 210px) * 16 / 9));
    aspect-ratio: 16 / 9;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 18px 30px rgba(20, 33, 61, 0.12));
  }

  /* ---------- Splash chrome (top bar + 4-phase bottom progress) ---------- */
  .intro-chrome {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 3vw, 32px) var(--gutter);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.24s ease-out;
  }
  .intro-chrome.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .intro-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    pointer-events: auto;
  }

  .intro-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .intro-logo {
    width: 28px;
    height: 28px;
    flex: none;
  }
  .intro-sheet {
    font: 500 12px/1 var(--f-mono);
    letter-spacing: 0.14em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .intro-skip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: 600 12px/1 var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: background 0.18s var(--ease), color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .intro-skip:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .intro-skip:hover .intro-skip-arrow {
    transform: translateX(3px);
  }
  .intro-skip-arrow {
    display: inline-block;
    transition: transform 0.18s var(--ease);
  }

  .intro-bottom {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    pointer-events: auto;
  }
  .intro-progress-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .intro-track {
    position: relative;
    width: 100%;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .intro-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
  }

  .intro-phases {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .intro-phase {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font: 500 11px/1.3 var(--f-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    opacity: 0.55;
    transition: opacity 0.25s ease, color 0.25s ease;
  }
  .intro-phase .phase-num {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    transition: color 0.25s ease;
  }
  .intro-phase[data-state="done"] {
    opacity: 0.82;
    color: var(--ink-soft);
  }
  .intro-phase[data-state="done"] .phase-num {
    color: var(--ink);
  }
  .intro-phase[data-state="active"] {
    opacity: 1;
    color: var(--ink);
  }
  .intro-phase[data-state="active"] .phase-num {
    color: var(--accent);
  }

  .intro-mobile-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font: 500 11px/1 var(--f-mono);
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .intro-mobile-phase {
    display: none;
    color: var(--ink);
  }
  .intro-scroll-hint {
    margin-left: auto;
    opacity: 0.72;
  }

  /* ---------- Pixel-exact alpha silhouette cutout (100% original video colors in Light & Dark modes) ---------- */
  .renovation-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    background: transparent;
    pointer-events: none;
    -webkit-mask-image: url('/assets/aistudio/renovation_mask.png');
    -webkit-mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-image: url('/assets/aistudio/renovation_mask.png');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    mask-mode: alpha;
  }

  .hero-video-slot {
    filter: drop-shadow(0 12px 22px rgba(20, 33, 61, 0.1));
  }

  /* Subtle elevation shadow on Ozalit dark blueprint without altering a single pixel of building color */
  :root[data-theme="dark"] .intro-mover,
  :root[data-theme="dark"] .hero-video-slot {
    filter: drop-shadow(0 20px 34px rgba(3, 14, 34, 0.45));
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .intro-mover,
    :root:not([data-theme="light"]) .hero-video-slot {
      filter: drop-shadow(0 20px 34px rgba(3, 14, 34, 0.45));
    }
  }

  /* ---------- Docked Hero Renovation Slot ---------- */
  .hero-renovation {
    position: relative;
    margin: 0;
    padding: clamp(8px, 1.4vw, 14px);
    border: 1px solid var(--line);
    background: transparent;
  }

  .hero-video-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: transparent;
  }

  .hero-progress-track {
    position: relative;
    height: 2px;
    margin-top: 8px;
    background: var(--line);
    opacity: 0;
    transition: opacity 0.25s ease;
    overflow: hidden;
  }
  .hero-renovation.is-replaying .hero-progress-track {
    opacity: 1;
  }
  .hero-progress-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
  }

  .hero-renovation-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 0;
    padding-top: 10px;
    border-top: 1px solid var(--line-strong);
    transition: opacity 0.35s var(--ease);
  }
  .hero-renovation.is-replaying .hero-renovation-caption {
    border-top-color: transparent;
  }

  .hero-phase-label {
    font: 500 11px/1.2 var(--f-mono);
    letter-spacing: 0.12em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hero-renovation.is-replaying .hero-phase-label {
    color: var(--ink);
  }

  .hero-replay-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px dashed var(--line-strong);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: 600 11px/1 var(--f-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .hero-replay-btn:hover {
