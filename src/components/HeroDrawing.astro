---
import { useT, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const d = t.home.drawing;
---
<figure class="hero-drawing" aria-label={t.home.drawingAria}>
  <svg viewBox="0 0 560 520" class="frame-svg" aria-hidden="true">
    <defs>
      <pattern id="soil" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="14" class="hatch-line" />
      </pattern>
      <pattern id="concrete" width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="4" cy="5" r="1" class="dot" /><circle cx="15" cy="12" r="1.4" class="dot" /><path d="M8 17 l3 -2 l1 3z" class="dot" />
      </pattern>
    </defs>
    <g>
      {[100, 220, 340, 460].map((x, i) => (
        <line x1={x} y1="44" x2={x} y2="500" class="axis draw" pathLength="1" style={`--d:${0.1 + i * 0.1}s`} />
      ))}
      <g class="fade" style="--d:.5s">
        {['A', 'B', 'C', 'D'].map((l, i) => (
          <>
            <circle cx={100 + i * 120} cy="30" r="14" class="bubble" />
            <text x={100 + i * 120} y="35" class="bubble-t">{l}</text>
          </>
        ))}
      </g>
    </g>
    <g class="fade" style="--d:2.9s">
      <line x1="100" y1="78" x2="460" y2="78" class="dim" />
      <path d="M96 82 l8 -8 M216 82 l8 -8 M336 82 l8 -8 M456 82 l8 -8" class="dim" />
      <text x="160" y="72" class="dim-t">6.00</text><text x="280" y="72" class="dim-t">6.00</text><text x="400" y="72" class="dim-t">6.00</text>
    </g>
    <rect x="20" y="430" width="520" height="70" fill="url(#soil)" class="fade" style="--d:.6s" />
    <line x1="20" y1="430" x2="540" y2="430" class="ground draw" pathLength="1" style="--d:.5s" />
    <rect x="78" y="408" width="404" height="22" class="found draw" pathLength="1" style="--d:.8s" />
    <rect x="78" y="408" width="404" height="22" fill="url(#concrete)" class="fade" style="--d:1.2s" />
    {[100, 220, 340, 460].map((x, i) => (
      <line x1={x} y1="408" x2={x} y2="110" class="col draw" pathLength="1" style={`--d:${1 + i * 0.1}s`} />
    ))}
    {[350, 290, 230, 170, 110].map((y, i) => (
      <line x1="86" y1={y} x2="474" y2={y} class="slab draw" pathLength="1" style={`--d:${1.6 + i * 0.2}s`} />
    ))}
    <path d="M86 110 v-14 M474 110 v-14" class="slab-thin draw" pathLength="1" style="--d:2.6s" />
    <rect x="214" y="110" width="12" height="298" class="shear fade" style="--d:2.7s" />
    <g class="fade" style="--d:3.0s">
      <line x1="508" y1="110" x2="508" y2="408" class="dim" />
      <path d="M504 114 l8 -8 M504 174 l8 -8 M504 234 l8 -8 M504 294 l8 -8 M504 354 l8 -8 M504 412 l8 -8" class="dim" />
      <text x="524" y="144" class="dim-t v">3.00</text><text x="524" y="204" class="dim-t v">3.00</text>
      <text x="524" y="264" class="dim-t v">3.00</text><text x="524" y="324" class="dim-t v">3.00</text>
      <text x="524" y="383" class="dim-t v">2.90</text>
    </g>
    <g class="fade" style="--d:3.2s">
      <path d="M40 110 l8 -10 h-16z" class="kot" /><text x="36" y="94" class="note">+15.00</text>
      <path d="M40 430 l8 -10 h-16z" class="kot" /><text x="36" y="414" class="note">±0.00</text>
    </g>
    <g class="fade" style="--d:3.3s">
      <circle cx="300" cy="468" r="17" class="pipe" /><circle cx="300" cy="468" r="11" class="pipe-in" />
      <rect x="324" y="459" width="108" height="18" class="label-bg" />
      <text x="330" y="472" class="note accent">{d.pipe}</text>
    </g>
    <g class="fade" style="--d:3.4s">
      <path d="M300 230 L352 200 H446" class="leader" /><circle cx="300" cy="230" r="3" class="leader-dot" />
      <text x="354" y="195" class="note">K-301 · 30/60</text>
      <path d="M226 320 L244 380 H346" class="leader" /><circle cx="226" cy="320" r="3" class="leader-dot" />
      <text x="248" y="375" class="note accent">{d.wall}</text>
    </g>
  </svg>
  <figcaption class="caption"><span>{d.section}</span><span>{d.scale}</span></figcaption>
</figure>
