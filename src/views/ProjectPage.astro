---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site.mjs';
import { ROUTES, projectPath, useT, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const t = useT(lang);
const pt = t.project;

const all = await getProjects(lang);
const p = all.find((x) => x.id === id)!;
const { Content } = await render(p.body);
const d = p.data;
const title = p.text.baslik;

// Galeri: küçük görseller <Image> ile, büyütme için ayrıca geniş sürüm üretilir
const gallery = await Promise.all(
  d.galeri.map(async (src, i) => ({ src, full: (await getImage({ src, width: 1800 })).src, alt: `${title} — ${pt.photo} ${i + 1}` })),
);
const og = await getImage({ src: d.kapak, width: 1200, format: 'jpg' });

const rows: [string, string][] = [];
if (p.client) rows.push([pt.client, p.client.tam]);
rows.push([d.durum === 'devam' ? pt.yearOngoing : pt.year, String(d.yil)]);
rows.push([pt.location, p.text.konum]);

const others = all
  .filter((x) => x.id !== id)
  .sort((a, b) => Number(b.data.kategori === d.kategori) - Number(a.data.kategori === d.kategori))
  .slice(0, 3);

const abs = (path: string) => new URL(path, SITE.url).href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.common.nav.home, item: abs(ROUTES.home[lang]) },
    { '@type': 'ListItem', position: 2, name: t.common.cat[d.kategori], item: abs(ROUTES[d.kategori][lang]) },
    { '@type': 'ListItem', position: 3, name: title, item: abs(projectPath(lang, id)) },
  ],
};
---
<Base lang={lang} page="project" navCurrent="projects" title={`${title} — MAKSEF`} description={p.text.ozet}
      alternates={{ tr: projectPath('tr', id), en: projectPath('en', id) }}
      og={{ image: og.src, width: og.attributes.width as number, height: og.attributes.height as number, alt: title, type: 'article' }}
      jsonLd={[breadcrumb]}>
  <nav class="crumbs" aria-label={pt.breadcrumb}>
    <a href={ROUTES.home[lang]}>{t.common.nav.home}</a><span>/</span>
    <a href={ROUTES[d.kategori][lang]}>{t.common.cat[d.kategori]}</a><span>/</span>
    <span aria-current="page">{title}</span>
  </nav>

  {gallery.length > 0 && (
    <section class="detail-sec detail-gallery-sec reveal" aria-label={pt.gallery}>
      <div class="gallery" data-gallery data-code={p.code}>
        {gallery.map((g, i) => (
          <button type="button" class="g-item" data-full={g.full} data-alt={g.alt} aria-label={`${pt.photo} ${i + 1} — ${pt.open}`}>
            <Image src={g.src} alt={g.alt} widths={[400, 800, 1200, 1600]}
                   sizes={i === 0 ? '(max-width: 640px) 100vw, (max-width: 1200px) 66vw, 50vw' : '(max-width: 640px) 50vw, (max-width: 1200px) 33vw, 25vw'} />
          </button>
        ))}
      </div>
    </section>
  )}

  <header class="page-head detail-head">
    <h1>{title}</h1>
  </header>

  <div class="detail-grid">
    <div class="detail-main reveal">
      <p class="lead">{p.text.ozet}</p>
      <h2 class="h-sub">{pt.scope}</h2>
      <div class="scope-body"><Content /></div>
    </div>
    <aside class="kunye reveal">
      <p class="kunye-title">{pt.kunye}<span>{p.code}</span></p>
      <dl>
        {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        <div><dt>{pt.category}</dt><dd><a href={ROUTES[d.kategori][lang]}>{t.common.cat[d.kategori]}</a></dd></div>
        <div><dt>{pt.state}</dt><dd><span class="badge inline" data-status={d.durum}>{t.common.status[d.durum]}</span></dd></div>
        {p.text.olcek && <div><dt>{pt.scale}</dt><dd>{p.text.olcek}</dd></div>}
      </dl>
    </aside>
  </div>

  {d.once && d.sonra && (
    <section class="detail-sec reveal">
      <h2 class="h-sub">{pt.beforeAfter}</h2>
      <div class="ba" style="--pos:50%">
        <Image src={d.sonra} alt={`${title} — ${pt.after}`} widths={[800, 1400]} sizes="(max-width: 1240px) 100vw, 1140px" />
        <div class="ba-before">
          <Image src={d.once} alt={`${title} — ${pt.before}`} widths={[800, 1400]} sizes="(max-width: 1240px) 100vw, 1140px" />
        </div>
        <span class="ba-label l">{pt.before}</span><span class="ba-label r">{pt.after}</span>
        <span class="ba-handle" aria-hidden="true"></span>
        <input type="range" min="0" max="100" value="50" aria-label={pt.baLabel}>
      </div>
    </section>
  )}

  <CtaBand lang={lang} heading={pt.ctaH} text={pt.ctaP} button={pt.ctaBtn} href={`${ROUTES.contact[lang]}?proje=${id}`} />

  {others.length > 0 && (
    <section class="section">
      <header class="section-head reveal"><p class="sheet-tag">{pt.otherTag}</p><h2 set:html={pt.otherH} /></header>
      <div class="projects stagger">{others.map((x) => <ProjectCard lang={lang} p={x} />)}</div>
    </section>
  )}
</Base>
